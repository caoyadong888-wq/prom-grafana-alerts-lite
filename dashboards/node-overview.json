    {
      "id": 10,
      "type": "timeseries",
      "title": "Disk free, 24h prediction",
      "description": "Demo panel uses a 15 minute window so it draws during a short run. Alert NodeDiskWillFill uses a 6 hour window and also requires free space under 20 percent.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "predict_linear(node_filesystem_avail_bytes{job=\"node\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|aufs|iso9660\",mountpoint!~\"^/(boot|run|sys|proc|dev|host|var/lib/docker|var/lib/kubelet)(/.*)?$\"}[15m], 24 * 3600)",
